# Copiar este archivo como .env (en la misma carpeta) y completar los valores.
# El .env NO se sube a GitHub: cada integrante tiene el suyo.

# --- Mail (Gmail) ---
# Cuenta que ENVÍA los mails de credenciales
MAIL_USERNAME=tu_cuenta@gmail.com
# Contraseña de aplicación de esa cuenta (16 letras), NO la contraseña normal.
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
MAIL_PASSWORD=

# --- Base de datos (opcional: estos son los valores por defecto) ---
#DB_URL=jdbc:mysql://localhost:3306/hito2_db
#DB_USERNAME=root
#DB_PASSWORD=root

# --- URL de la app que aparece en los mails (opcional) ---
#APP_BASE_URL=http://localhost:8080
